{
  "name": "stockfolio",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "preview_urls": false,
  "triggers": {"crons": ["*/15 * * * *"]},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockfolio",
      "migrations_dir": "migrations"
    }
  ]
}
